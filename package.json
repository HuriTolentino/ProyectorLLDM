{
  "name": "proyector-lldm",
  "version": "1.5.2",
  "description": "Cabina de proyección LLDM para TV y transmisión OBS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "build:lists": "npm --prefix lista-oraciones run build",
    "build:release": "python scripts/package-release.py",
    "build:converter": "pwsh -NoProfile -File scripts/build-converter.ps1",
    "test:converter": "node scripts/test-bundled-converter.cjs",
    "build:windows": "electron-builder --win nsis --x64 --publish never",
    "setup:lists": "npm --prefix lista-oraciones ci && npm run build:lists",
    "benchmark": "node scripts/benchmark.cjs"
  },
  "keywords": [],
  "author": "Huri Tolentino",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "commonjs",
  "dependencies": {
    "buffer-crc32": "1.0.0",
    "express": "^5.3.0",
    "fontkit": "^2.0.4",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2"
  }
}
